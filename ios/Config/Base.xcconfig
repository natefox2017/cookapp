// Shared base settings. Secrets come from Secrets.xcconfig (gitignored) or Secrets.example.xcconfig.

PRODUCT_BUNDLE_IDENTIFIER = com.natefox.cookapp
PRODUCT_NAME = CookApp
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0

COOKAPP_ENVIRONMENT = debug
COOKAPP_SUPABASE_URL = https://semsjyrqjnumpvanibip.supabase.co
COOKAPP_SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
COOKAPP_REVENUECAT_API_KEY = REPLACE_WITH_REVENUECAT_API_KEY
COOKAPP_GOOGLE_CLIENT_ID = REPLACE_WITH_GOOGLE_CLIENT_ID

INFOPLIST_KEY_COOKAPP_ENVIRONMENT = $(COOKAPP_ENVIRONMENT)
INFOPLIST_KEY_COOKAPP_SUPABASE_URL = $(COOKAPP_SUPABASE_URL)
INFOPLIST_KEY_COOKAPP_SUPABASE_ANON_KEY = $(COOKAPP_SUPABASE_ANON_KEY)
INFOPLIST_KEY_COOKAPP_REVENUECAT_API_KEY = $(COOKAPP_REVENUECAT_API_KEY)
INFOPLIST_KEY_COOKAPP_GOOGLE_CLIENT_ID = $(COOKAPP_GOOGLE_CLIENT_ID)
