{
  "openapi": "3.1.0",
  "info": {
    "title": "CookApp Cloud Backend API",
    "version": "1.0.0",
    "description": "Supabase-backed API for CookApp. Primary data access is PostgREST (`/rest/v1`)\nwith Row Level Security. Privileged operations use Edge Functions (`/functions/v1`).\n\nAuthentication: Supabase Auth session JWT (`Authorization: Bearer <access_token>`).\nThird-party OAuth tokens are never stored server-side.\n\nProject: `semsjyrqjnumpvanibip` \u00b7 Base: `https://semsjyrqjnumpvanibip.supabase.co`\n",
    "contact": {
      "name": "CookApp"
    }
  },
  "servers": [
    {
      "url": "https://semsjyrqjnumpvanibip.supabase.co",
      "description": "Supabase Cloud"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "User"
    },
    {
      "name": "Recipe"
    },
    {
      "name": "Collection"
    },
    {
      "name": "Ingredient"
    },
    {
      "name": "Grocery"
    },
    {
      "name": "MealPlan"
    },
    {
      "name": "Pantry"
    },
    {
      "name": "Category"
    },
    {
      "name": "Storage"
    },
    {
      "name": "Subscription"
    },
    {
      "name": "System"
    }
  ],
  "paths": {
    "/auth/v1/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Session token exchange / refresh",
        "description": "Supabase Auth endpoint. Clients use the Supabase SDK for Apple ID token,\nGoogle OAuth, logout, and refresh. Documented for completeness.\n",
        "security": [],
        "responses": {
          "200": {
            "description": "Session issued"
          }
        }
      }
    },
    "/functions/v1/delete-account": {
      "post": {
        "tags": [
          "Auth",
          "User"
        ],
        "summary": "Delete account",
        "description": "Purges user storage objects and deletes the auth user (cascades all owned rows).",
        "operationId": "deleteAccount",
        "responses": {
          "200": {
            "description": "Account deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/functions/v1/revenuecat-webhook": {
      "post": {
        "tags": [
          "Subscription"
        ],
        "summary": "RevenueCat webhook",
        "description": "Server-to-server. Auth via `Authorization: Bearer <REVENUECAT_WEBHOOK_SECRET>`.\nJWT verification disabled; service role used internally.\n",
        "security": [
          {
            "WebhookBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Event received"
          }
        }
      }
    },
    "/functions/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Backend health / module probe",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/rest/v1/profiles": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "GET User Profile",
        "operationId": "getUserProfile",
        "parameters": [
          {
            "$ref": "#/components/parameters/PreferReturn"
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter `eq.<user_id>` (own id only under RLS)"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserProfile"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "User"
        ],
        "summary": "UPDATE User Profile",
        "operationId": "updateUserProfile",
        "parameters": [
          {
            "$ref": "#/components/parameters/PreferReturn"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserProfile"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/recipes": {
      "get": {
        "tags": [
          "Recipe"
        ],
        "summary": "Recipe List / Detail",
        "description": "List own recipes. For detail use `id=eq.<uuid>` (maps to GET /recipes/:id).\nUpdate: `PATCH` with `id=eq.<uuid>` (PUT /recipes/:id).\nDelete: `DELETE` with `id=eq.<uuid>` (DELETE /recipes/:id).\n",
        "operationId": "listRecipes",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Filter e.g. `eq.<uuid>` for single recipe",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "created_at.desc"
            }
          },
          {
            "name": "select",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "*"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Own recipes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Recipe"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Recipe"
        ],
        "summary": "Create Recipe",
        "operationId": "createRecipe",
        "parameters": [
          {
            "$ref": "#/components/parameters/PreferReturn"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      },
      "patch": {
        "tags": [
          "Recipe"
        ],
        "summary": "Update Recipe",
        "operationId": "updateRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eq.<uuid>"
            }
          },
          {
            "$ref": "#/components/parameters/PreferReturn"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Recipe"
        ],
        "summary": "Delete Recipe",
        "operationId": "deleteRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eq.<uuid>"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/rest/v1/collections": {
      "get": {
        "tags": [
          "Collection"
