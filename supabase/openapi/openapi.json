    "/storage/v1/object/{bucket}/{user_id}/{object}": {
      "parameters": [
        {
          "name": "bucket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "avatars",
              "recipe-covers",
              "recipe-images"
            ]
          }
        },
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "object",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Upload object (private bucket, path must start with auth user id)",
        "responses": {
          "200": {
            "description": "Uploaded"
          }
        }
      },
      "get": {
        "tags": [
